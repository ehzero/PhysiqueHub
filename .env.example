# Prisma database connection.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"

# Direct database connection for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Admin-only page password.
ADMIN_PASSWORD="change-this-password"

# Optional. If omitted, ADMIN_PASSWORD is used to sign admin sessions.
ADMIN_SESSION_SECRET="change-this-session-secret"

# Public base URL used for canonical, Open Graph, sitemap, and robots metadata.
NEXT_PUBLIC_SITE_URL="https://physiquehub.vercel.app"
