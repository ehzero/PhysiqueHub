generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model CompetitionSchedule {
  id                    String  @id
  organizationId        String
  organizationName      String
  organizationShortName String?
  title                 String
  subtitle              String?
  aliasesJson           String  @default("[]")
  seasonYear            Int?

  dateStartsOn   DateTime?
  dateEndsOn     DateTime?
  dateTimezone   String    @default("Asia/Seoul")
  dateRawText    String?
  dateConfidence String    @default("low")

  registrationOpensAt    DateTime?
  registrationClosesAt   DateTime?
  registrationStatus     String    @default("unknown")
  registrationUrl        String?
  registrationRawText    String?
  registrationConfidence String    @default("low")
  feeCurrency            String    @default("UNKNOWN")
  feeMinAmount           Int?
  feeMaxAmount           Int?
  feeRawText             String?

  country            String  @default("KR")
  region             String?
  city               String?
  venue              String?
  address            String?
  locationRawText    String?
  locationConfidence String  @default("low")

  divisionsJson String @default("[]")
  tagsJson      String @default("[]")
  flagsJson     String @default("{}")

  posterImageUrl String?
  thumbnailUrl   String?
  imageSourceUrl String?

  sourceType          String
  sourceUrl           String
  canonicalUrl        String?
  detailUrl           String?
  sourceEventId       String?
  sourceUpdatedAt     DateTime?
  fetchedAt           DateTime
  parserName          String?
  parserVersion       String?
  rawHash             String?
  rawTitle            String?
  rawDateText         String?
  rawLocationText     String?
  rawRegistrationText String?

  crawlStatus       String  @default("not-started")
  reviewStatus      String  @default("pending")
  confidence        String  @default("low")
  qualityIssuesJson String  @default("[]")
  notes             String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  normalizedAt DateTime?

  @@unique([organizationId, sourceEventId], name: "competition_schedule_org_source_event_unique")
  @@index([organizationId])
  @@index([seasonYear])
  @@index([dateStartsOn])
  @@index([registrationStatus])
  @@index([reviewStatus])
  @@index([crawlStatus])
}

model CompetitionSourceProgress {
  organizationId    String   @id
  organizationName  String
  status            String   @default("not-started")
  sourceConfirmed   Boolean  @default(false)
  parserImplemented Boolean  @default(false)
  sampleCollected   Boolean  @default(false)
  reviewed          Boolean  @default(false)
  sourceUrlsJson    String   @default("[]")
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Article {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  subtitle       String?
  excerpt        String
  category       String    @default("대회 결과")
  categorySlug   String    @default("competition-result")
  tag            String    @default("")
  status         String    @default("draft")
  language       String    @default("ko")
  authorName     String    @default("PhysiqueHub 편집부")
  heroImageUrl   String?
  readMinutes    Int       @default(5)
  posterTheme    String    @default("navy")
  posterFigure   Int       @default(0)
  isFeatured     Boolean   @default(false)
  sortOrder      Int       @default(0)
  bodyMarkdown   String
  bodyBlocksJson String    @default("[]")
  sourceUrlsJson String    @default("[]")
  tagsJson       String    @default("[]")
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([category])
  @@index([categorySlug])
  @@index([isFeatured, publishedAt])
  @@index([createdAt])
}

model ContactInquiry {
  id          String              @id @default(cuid())
  category    String
  name        String
  email       String
  message     String
  status      String              @default("new")
  attachments ContactAttachment[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ContactAttachment {
  id           String         @id @default(cuid())
  inquiryId    String
  inquiry      ContactInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  originalName String
  pathname     String         @unique
  url          String
  downloadUrl  String?
  contentType  String?
  access       String         @default("private")
  size         Int
  createdAt    DateTime       @default(now())

  @@index([inquiryId])
}

model AnalyticsSession {
  id             String           @id
  visitorId      String
  landingPath    String
  referrer       String?
  referrerHost   String?
  channel        String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  ipAddress      String?
  userAgent      String?
  deviceCategory String?
  browserName    String?
  osName         String?
  displayMode    String?
  trafficType    String           @default("human")
  botName        String?
  botReason      String?
  botVerified    Boolean          @default(false)
  reverseDnsHost String?
  classifiedAt   DateTime?
  classificationVersion String?
  startedAt      DateTime         @default(now())
  lastSeenAt     DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  events         AnalyticsEvent[]

  @@index([visitorId])
  @@index([startedAt])
  @@index([lastSeenAt])
  @@index([channel])
  @@index([trafficType])
  @@index([botName])
  @@index([classifiedAt])
  @@index([createdAt])
}

model AnalyticsEvent {
  id             String           @id @default(cuid())
  eventId        String?          @unique
  sessionId      String
  session        AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  visitorId      String
  name           String
  path           String
  occurredAt     DateTime         @default(now())
  competitionId  String?
  searchQuery    String?
  resultCount    Int?
  propertiesJson String           @default("{}")
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime         @default(now())

  @@index([sessionId])
  @@index([visitorId])
  @@index([name, occurredAt])
  @@index([competitionId])
  @@index([occurredAt])
  @@index([createdAt])
}

model BotDetectionRule {
  id               String   @id
  enabled          Boolean  @default(true)
  priority         Int      @default(100)
  matchType        String
  pattern          String
  trafficType      String
  botName          String?
  botReason        String?
  verifyReverseDns Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([enabled, priority])
}

model AnalyticsDnsCache {
  ipAddress String   @id
  hostname  String?
  lookedUpAt DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
